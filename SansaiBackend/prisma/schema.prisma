// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================
//

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum Role {
  ADMIN
  CUSTOMER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum TokenType {
  ACCESS
  REFRESH
  EMAIL_VERIFY
  PASSWORD_RESET
  OTP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  RAZORPAY
  STRIPE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  SYSTEM
  ORDER
  PAYMENT
  OFFER
}

enum InventoryAction {
  IN
  OUT
  RETURN
  CANCELLED
  MANUAL
}

//
// ================= AUTH =================
//

model Auth {
  id Int @id @default(autoincrement())

  name     String
  email    String  @unique
  password String?
  phone    String? @unique

  role Role @default(CUSTOMER)

  provider AuthProvider @default(LOCAL)

  googleId String? @unique

  profileImage String?

  isActive        Boolean @default(true)
  isEmailVerified Boolean @default(false)

  createdIp   String?
  lastLoginIp String?
  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  customerProfile CustomerProfile?

  tokens           Token[]
  sessions         Session[]
  otpVerifications OtpVerification[]
  loginActivities  LoginActivity[]
  adminAuditLogs   AdminAuditLog[]

  addresses     Address[]
  wishlist      Wishlist[]
  cartItems     Cart[]
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  tickets       SupportTicket[]
  complaints    Complaint[]

  oauthAccounts OAuthAccount[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([deletedAt])
}

model OAuthAccount {
  id Int @id @default(autoincrement())

  userId Int
  user   Auth @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider AuthProvider

  providerAccountId String

  accessToken  String?
  refreshToken String?

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
}

model CustomerProfile {
  id Int @id @default(autoincrement())

  authId Int  @unique
  auth   Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  gender      Gender?
  dateOfBirth DateTime?

  profileImage String?

  totalSpent    Decimal @default(0) @db.Decimal(12, 2)
  walletBalance Decimal @default(0) @db.Decimal(12, 2)

  referralCode String? @unique

  totalOrders   Int       @default(0)
  lastOrderDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Token {
  id Int @id @default(autoincrement())

  userId Int
  user   Auth @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String    @unique
  tokenType TokenType

  expiresAt DateTime

  isRevoked Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Session {
  id String @id @default(uuid())

  userId Int
  user   Auth @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken String @unique

  ipAddress  String?
  userAgent  String?
  deviceInfo String?

  isActive Boolean @default(true)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model OtpVerification {
  id Int @id @default(autoincrement())

  userId Int
  user   Auth @relation(fields: [userId], references: [id], onDelete: Cascade)

  otpCode String
  purpose String

  attempts Int @default(0)

  isUsed Boolean @default(false)

  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginActivity {
  id Int @id @default(autoincrement())

  userId Int
  user   Auth @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?

  browser    String?
  os         String?
  deviceInfo String?

  loginAt  DateTime  @default(now())
  logoutAt DateTime?

  @@index([userId, loginAt])
}

model RateLimit {
  id Int @id @default(autoincrement())

  ipAddress String
  endpoint  String

  attempts Int @default(0)

  blockedUntil DateTime?

  createdAt DateTime @default(now())

  @@index([ipAddress, endpoint])
}

//
// ================= CATEGORY =================
//

model Category {
  id Int @id @default(autoincrement())

  name String @unique
  slug String @unique

  description String?
  image       String?

  isActive Boolean @default(true)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories SubCategory[]
  products      Product[]

  @@index([slug])
}

model SubCategory {
  id Int @id @default(autoincrement())

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name String
  slug String @unique

  description String?
  image       String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([categoryId, name])
}

//
// ================= PRODUCT =================
//

model Product {
  id Int @id @default(autoincrement())

  categoryId    Int
  subCategoryId Int?

  category    Category     @relation(fields: [categoryId], references: [id])
  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id])

  name String
  slug String @unique

  shortDescription String?
  description      String

  fabricType       String?
  fitType          String?
  careInstructions String?

  material      String?
  finish        String?
  dimensions    String?
  packQuantity  Int     @default(1)
  unitOfMeasure String? @default("piece")

  brand String?

  sku String @unique

  basePrice     Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  costPrice     Decimal? @db.Decimal(10, 2)

  weight Decimal? @db.Decimal(10, 2)

  tags String?

  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  canonicalUrl   String?

  totalViews Int @default(0)
  totalSold  Int @default(0)

  averageRating Decimal @default(0) @db.Decimal(3, 2)

  isActive     Boolean @default(true)
  isFeatured   Boolean @default(false)
  isBestSeller Boolean @default(false)
  isNewArrival Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  images        ProductImage[]
  videos        ProductVideo[]
  variants      ProductVariant[]
  reviews       Review[]
  cartItems     Cart[]
  wishlist      Wishlist[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId, isActive])
  @@index([isFeatured])
  @@index([isBestSeller])
  @@index([isNewArrival])
}

model ProductImage {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  imageUrl String
  publicId String?
  blurHash String?
  altText  String?

  isPrimary Boolean @default(false)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([productId, displayOrder])
  @@index([publicId])
}

model ProductVideo {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  videoUrl    String
  thumbnailUrl String?
  publicId     String?
  title        String?
  displayOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([productId, displayOrder])
  @@index([publicId])
}

model ProductVariant {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size  String
  color String

  sku String @unique

  price Decimal? @db.Decimal(10, 2)

  stock         Int @default(0)
  reservedStock Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems     Cart[]
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  @@unique([productId, size, color])
}

model InventoryLog {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  action InventoryAction

  quantityChanged Int

  previousStock Int
  newStock      Int

  reference String?
  notes     String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
}

//
// ================= ADDRESS =================
//

model Address {
  id Int @id @default(autoincrement())

  userId Int
  user   Auth @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String
  phone    String

  addressLine1 String
  addressLine2 String?

  city       String
  state      String
  postalCode String

  country String @default("IN")

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

//
// ================= CART =================
//

model Cart {
  id Int @id @default(autoincrement())

  userId Int
  user   Auth @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, variantId])
}

model Wishlist {
  id Int @id @default(autoincrement())

  userId    Int
  productId Int

  user    Auth    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

//
// ================= COUPON =================
//

model Coupon {
  id Int @id @default(autoincrement())

  code String @unique

  description String?

  couponType CouponType

  discountValue Decimal @db.Decimal(10, 2)

  maxDiscount Decimal? @db.Decimal(10, 2)

  minOrderAmount Decimal? @db.Decimal(10, 2)

  maxUsagePerUser Int  @default(1)
  maxTotalUsage   Int?

  totalUsed Int @default(0)

  isActive Boolean @default(true)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ================= ORDER =================
//

model Order {
  id Int @id @default(autoincrement())

  orderNumber String @unique

  userId Int
  user   Auth @relation(fields: [userId], references: [id], onDelete: Cascade)

  addressId Int?
  address   Address? @relation(fields: [addressId], references: [id])

  subtotal Decimal @db.Decimal(12, 2)

  discountAmount  Decimal @default(0) @db.Decimal(12, 2)
  shippingCharges Decimal @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal @default(0) @db.Decimal(12, 2)

  totalAmount Decimal @db.Decimal(12, 2)

  couponCode String?

  paymentMethod PaymentMethod

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  shippingTrackingId String?

  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  customerNotes String?
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  payment        Payment?
  timelines      OrderTimeline[]
  returnRequests ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity Int

  unitPrice Decimal @db.Decimal(10, 2)

  discountPerUnit Decimal @default(0) @db.Decimal(10, 2)

  totalPrice Decimal @db.Decimal(12, 2)

  size  String?
  color String?

  createdAt DateTime @default(now())
}

model OrderTimeline {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status OrderStatus

  notes String?

  changedByAdminId Int?

  createdAt DateTime @default(now())
}

//
// ================= RETURN =================
//

model ReturnRequest {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderItemId Int

  reason String

  status ReturnStatus @default(REQUESTED)

  refundAmount Decimal @db.Decimal(12, 2)

  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ================= PAYMENT =================
//

model Payment {
  id Int @id @default(autoincrement())

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  paymentMethod PaymentMethod

  transactionId String? @unique

  gatewayResponse Json?

  amount Decimal @db.Decimal(12, 2)

  status PaymentStatus @default(PENDING)

  errorMessage String?

  retries Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentWebhookLog {
  id Int @id @default(autoincrement())

  gateway String

  eventType String

  payload Json

  createdAt DateTime @default(now())
}

//
// ================= REVIEW =================
//

model Review {
  id Int @id @default(autoincrement())

  userId    Int
  productId Int

  user    Auth    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  rating Int

  comment String?

  images String?

  verified Boolean @default(false)

  helpful Int @default(0)

  isApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

//
// ================= NOTIFICATION =================
//

model Notification {
  id Int @id @default(autoincrement())

  userId Int
  user   Auth @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String

  type NotificationType @default(SYSTEM)

  data Json?

  isRead Boolean @default(false)

  readAt DateTime?

  createdAt DateTime @default(now())
}

//
// ================= SUPPORT =================
//

model SupportTicket {
  id Int @id @default(autoincrement())

  ticketNumber String @unique

  userId Int
  user   Auth @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject String
  message String

  priority String @default("NORMAL")

  status TicketStatus @default(OPEN)

  adminResponse String?

  attachments String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Complaint {
  id Int @id @default(autoincrement())

  complaintNumber String @unique

  userId Int
  user   Auth @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId Int?

  subject     String
  description String

  status ComplaintStatus @default(PENDING)

  adminResponse String?
  resolution    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ================= ADMIN =================
//

model AdminAuditLog {
  id Int @id @default(autoincrement())

  adminId Int
  admin   Auth @relation(fields: [adminId], references: [id], onDelete: Cascade)

  action String
  module String

  targetId String?

  description String?

  changedData Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
}

//
// ================= ANALYTICS =================
//

model DailyAnalytics {
  id Int @id @default(autoincrement())

  date DateTime @unique

  totalOrders Int

  totalRevenue Decimal @db.Decimal(12, 2)

  averageOrderValue Decimal @db.Decimal(12, 2)

  totalCustomers Int

  newCustomers Int

  topProducts   Json?
  topCategories Json?

  createdAt DateTime @default(now())
}

//
// ================= BANNER =================
//

model Banner {
  id Int @id @default(autoincrement())

  title String

  description String?

  imageUrl String

  linkUrl String?

  isActive Boolean @default(true)

  displayOrder Int @default(0)

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BulkInquiry {
  id Int @id @default(autoincrement())

  name String
  email String
  phone String
  company String
  inquiryType String
  requirements String

  status String @default("NEW")
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
