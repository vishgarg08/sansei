PORT=3001

DATABASE_URL="postgresql://username:password@localhost:5432/sansei?schema=public"

GOOGLE_CLIENT_ID=your_google_client_id

JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_EXPIRES_IN=15d
JWT_REFRESH_EXPIRES_IN=30d
REDIS_URL=redis://127.0.0.1:6379
AUTH_USER_CACHE_TTL_SECONDS=300

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
ALLOWED_OUTBOUND_DOMAINS=http://localhost:5173/

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
FRONTEND_ORIGINS=http://localhost:5173,https://localhost:5173
